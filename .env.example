# Gnani Official Speech API Key (Required for Step 4 STT & TTS)
# Generate at https://app.gnani.ai/voice
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE=Kaveri
GNANI_LANGUAGE=en-IN

# Optional Hosted LLM API Keys (Steps 1–3)
# Leave blank to use the built-in deterministic RAG & policy engine
LLM_PROVIDER=auto
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional explicit path to extracted Capstone_Project_Dataset_FTTT_2026 folder
ZENTROMART_DATASET_DIR=
